{
  "$schema": "https://turbo.build/schema.json",
  "pipeline": {
    "build:android": {
      "env": ["ORG_GRADLE_PROJECT_newArchEnabled"],
      "inputs": [
        "package.json",
        "android",
        "!android/build",
        "src/*.ts",
        "src/*.tsx",
        "examples/expo-51/package.json",
        "examples/expo-51/android",
        "!examples/expo-51/android/.gradle",
        "!examples/expo-51/android/build",
        "!examples/expo-51/android/app/build",
        "examples/bare-rn/package.json",
        "examples/bare-rn/android",
        "!examples/bare-rn/android/.gradle",
        "!examples/bare-rn/android/build",
        "!examples/bare-rn/android/app/build"
      ],
      "outputs": []
    },
    "build:ios": {
      "env": ["RCT_NEW_ARCH_ENABLED"],
      "inputs": [
        "package.json",
        "*.podspec",
        "ios",
        "src/*.ts",
        "src/*.tsx",
        "examples/expo-51/package.json",
        "examples/expo-51/ios",
        "!examples/expo-51/ios/build",
        "!examples/expo-51/ios/Pods",
        "examples/bare-rn/package.json",
        "examples/bare-rn/ios",
        "!examples/bare-rn/ios/build",
        "!examples/bare-rn/ios/Pods"
      ],
      "outputs": []
    }
  }
}
